{
  "tiers": {
    "official": {
      "label": "Official",
      "weight": 0.9,
      "order": 0,
      "description": "The Ukrainian Air Force and the official alert feed. The highest trust weight in the model: messages from here raise a target's confidence the most."
    },
    "recon": {
      "label": "Reconnaissance",
      "weight": 0.7,
      "order": 1,
      "description": "Channels with a consolidated picture of the air situation across the country."
    },
    "regional": {
      "label": "Regional observers",
      "weight": 0.55,
      "order": 2,
      "description": "One region, people on the ground. They provide the specifics \"from where and to where\" that no national channel provides."
    },
    "aggregator": {
      "label": "Aggregators",
      "weight": 0.15,
      "order": 3,
      "description": "Nationwide reposters. Fast but noisy: they only count when they coincide with other sources, never by themselves."
    },
    "russia": {
      "label": "Russia-side monitoring",
      "weight": 0.5,
      "order": 4,
      "description": "Russian-side channels that announce drone and missile danger over Russia and the occupied territory. They feed the separate \"over Russia\" layer only, never targets or alerts over Ukraine."
    }
  },
